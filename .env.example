# Copie este arquivo para .env e preencha (nao commitar).
PORT=3000

# OpenRouter (juiz IA). Vazio => jogo funciona offline com fallback local.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Token do painel admin (envie no header x-admin-token)
ADMIN_TOKEN=matilha-admin

# Supabase (banco de perguntas + estado de jogo). Use a SERVICE ROLE key,
# apenas server-side (funcoes Vercel / dev server).
SUPABASE_URL=https://tnjusdbqmbgydjdqzjem.supabase.co
SUPABASE_SERVICE_ROLE_KEY=colocar-sua-service-role-aqui

# Web (build-time, visivel no browser): precisa da ANON key publica.
# Copie tambem para apps/web/.env para o build local.
VITE_SUPABASE_URL=https://tnjusdbqmbgydjdqzjem.supabase.co
VITE_SUPABASE_ANON_KEY=colocar-sua-anon-key-aqui
